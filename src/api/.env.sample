# ---- Local tracing ----
# When true, traces are written locally (console + .runs) instead of Azure Monitor.
LOCAL_TRACING_ENABLED=false

# ---- Microsoft Foundry project (current-generation, endpoint-based) ----
# Foundry project endpoint, e.g. https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=
# Azure AI Services / OpenAI endpoint, e.g. https://<account>.services.ai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_NAME=

# ---- Model deployments ----
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-sol
AZURE_OPENAI_4_EVAL_DEPLOYMENT_NAME=gpt-5.6-sol-eval
AZURE_EMBEDDING_NAME=text-embedding-3-large

# ---- Grounding + retrieval ----
BING_CONNECTION_NAME=bing-connection
AZURE_SEARCH_ENDPOINT=
AI_SEARCH_ENDPOINT=

# ---- Subscription / project identifiers ----
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_PROJECT_NAME=
AZURE_LOCATION=

# ---- Managed identity (deployed) ----
# Client id of the user-assigned managed identity used with DefaultAzureCredential.
AZURE_CLIENT_ID=

# ---- Observability ----
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ---- Content safety (image check) ----
CONTENT_SAFETY_ENDPOINT=